#!/usr/bin/bash
## 5-1-2024, plot 3 subplots, HGSD Plans

gmt begin Fig2_50year_HGSD_Plans ps,pdf,jpg
# gmt begin Fig1_TX ps,pdf,jpg

#gmt set FONT_TITLE 8p,19,black
#gmt set FONT_LABEL 8p,19,black
gmt set FONT_LABEL 8p,Helvetica
gmt set MAP_FRAME_TYPE plain
gmt set FORMAT_GEO_MAP ddd.x  MAP_GRID_CROSS_SIZE_PRIMARY0.03i

gmt set FONT_TITLE 8p, Helvetica
gmt set MAP_TITLE_OFFSET 0.1p
gmt set FONT_ANNOT_PRIMARY 8p

### 10-14-2019, plot GOM-LA subfigure
### I spent some time to handle the  MORVEL_Plateboundaries.xy file tha tI downloaded from MORVEL.
## The original all file "All_boundaries is not in a GMT format, it is in lat--long format, 
## I need to add "-:" in psxy to switch from lat-long to lon-lat. The most trick part is that the
## GMT psxy need to identify ">" to separate different segment. However, most text files do not have that.
## I use "sed -i 's/[a-z]/>/g' inputfile" to replace all character lines with ">". I may need to keep the
## original characters and just add ">" infront. Will do this in the future!
## This is what I used----
    ## cp All_boundaries  MORVEL_Plateboundaries.xy
    ## sed -i 's/[a-z]/>/g' MORVEL_Plateboundaries.xy    !! This just replaced all characters with >
    ## sed -i 's/[A-Z]/>/g' MORVEL_Plateboundaries.xy
    ## psxy $F $S -:   MORVEL_Plateboundaries.xy  -W2.0,blue  -O -K -V   >> $O
##10-22-2019, Handle Peter Bird's plate boundary dataFig2_HoustonNet_allGPS.gmt6 
   ## download PB2002_boundaries.dig.txt from http://peterbird.name/oldFTP/PB2002/, 
   ## copy to PB2002_boundaries.xy
   ## replace "**" line with ">" ,
     # sed -i 's/[***]/>/g' PB2002_boundaries.xy
   ## add ">" infront of all character lines
     #sed 's/[A-Z]/>/' test.xy > tmp.xy



## Whole GOM
 # F="-R-110/-75/13/37.5"
## 50 RF Area
#F="-R-98.5/-93.5/25.85/30.3"


## CA-NA-COCOS area
 # F="-R-95/-85/11/20"
## Houston area
F="-Rd-96.1/-94.8/29.1/30.2"
S="-JM16c"

I="-I0.01" 

gmt subplot begin 1x3 -Fs6.5c -M0c 
gmt set FONT_ANNOT_PRIMARY 8p

##########################First Subplot
#gmt subplot set 0 -A'(a) HGSD 1975 Plan'
gmt subplot set 0  
gmt basemap $F  -Ba30mf10m -BWSen 

## HGSD Area 1--light green 204/255/153, HG-Area-2, light blue 204/229/255, HG3-light pink, 255/204/255
gmt psxy   HGSD_1975Plan_Part1.xy -W0.5,black -L -G204/255/153@50
gmt psxy   HGSD_1975Plan_Part2.xy  -W0.5,black -L -G204/255/153@50 

## add three loops
gmt psxy   TX_Counties.psxy  -W0.6,black -L 
##psxy $F $S Houston_IH99_outerloop.psxy -m -W10t20_10:0 
gmt psxy  Houston_SL8_middle_loop.psxy  -W2,gray -L 
gmt psxy  Houston_IH610_inner_loop.psxy  -W2,gray -L 

## permanent rivers
gmt pscoast -Df -I1/2.0p,blue,-  -Sdeepskyblue
### plot major TX Coast Cities
gmt text   -F+a0+f11+jMC   <<EOF 
-95.370 29.760 Houston
EOF
gmt text  -F+a0+f11+jMC     <<EOF  
-95  28.84    Gulf of Mexico
EOF


## plot the names of district
gmt text  -F+a0+f8+jMC   << EOF
-95.05  29.45  Galveston 
-95.05  29.4  County
-95.5 29.98  Harris County
-95.75  29.5  Fort Bend County
EOF
gmt text  -F+a0+f10+jMC -Gwhite  << EOF
-95.2  29.65   ACE
EOF
gmt text  -F+a0+f10+jML -Gwhite  << EOF
-96.05  29.17   (a) HGSD 1975 Plan
EOF

###################### Second subplot
gmt subplot set 1 
gmt basemap $F  -Ba30mf10m -BwSen 

## HGSD Area 1--light green 204/255/153, HG-Area-2, light blue 204/229/255, HG3-light pink, 255/204/255
gmt psxy  HG_Area_1.psxy  -W0.5,black -L -G204/255/153@50
gmt psxy   HGSD_1985Plan_Part2.xy  -W0.5,black -L -G204/229/255 
# area 8
gmt psxy   HG_Area_3.psxy  -W0.5,black  -L  -Ggray

gmt psxy   HGSD_1985Plan_Part3.xy  -W0.5,black -L -Gblue 
gmt psxy   HGSD_1985Plan_Part4.xy  -W0.5,black -L -Gcyan
gmt psxy   HGSD_1985Plan_Part5.xy  -W0.5,black -L -Ggreen
gmt psxy   HGSD_1985Plan_Part6.xy  -W0.5,black -L -Gpink
gmt psxy   HGSD_1985Plan_Part7.xy  -W0.5,black -L -Gorange

## add three loops
gmt psxy   TX_Counties.psxy  -W0.6,black -L 
##psxy $F $S Houston_IH99_outerloop.psxy -m -W10t20_10:0 
gmt psxy  Houston_SL8_middle_loop.psxy  -W2,gray -L 
gmt psxy  Houston_IH610_inner_loop.psxy  -W2,gray -L 

## permanent rivers
gmt pscoast -Df -I1/2.0p,blue,-  -Sdeepskyblue
### plot major TX Coast Cities
#gmt text   -F+a0+f11+jMC   <<EOF 
#-95.370 29.760 Houston
#EOF
gmt text  -F+a0+f11+jMC     <<EOF  
-95  28.84    Gulf of Mexico
EOF


## plot the names of district
gmt text  -F+a0+f8+jMC   << EOF
-95.05  29.45  Galveston 
-95.05  29.4  County
#-95.16  29.98  Harris County
-95.75  29.5  Fort Bend County
EOF
gmt text  -F+a0+f9+jMC -Gwhite  << EOF
-95.05  29.6   1
-95.35  29.65   2
-95.52  29.75   3
-95.63  29.75   4
-95.25  30   5
-95.45  30   6
-95.65  30   7
-95.8  30   8
EOF
gmt text  -F+a0+f10+jML -Gwhite  << EOF
-96.05  29.17   (b) HGSD 1985 Plan
EOF
   
    
######################### Third subplot
gmt subplot set 2 
gmt basemap $F  -Ba30mf10m -BwSEn 
    
## plot subsidence district
##LoneStar SD: light yellow-red, 255/178/202
#gmt psxy   LSGCD.psxy  -W1,black  -G255/170/170@75
