## HGSD Area 1--light green 204/255/153, HG-Area-2, light blue 204/229/255, HG3-light pink, 255/204/255
gmt psxy  HG_Area_1.psxy  -W0.5,black -L -G204/255/153@50
gmt psxy   HG_Area_2.psxy  -W0.5,black -L -G204/229/255 
gmt psxy   HG_Area_3.psxy  -W0.5,black -L -G255/155/255@55 
    
##FB-A,light yellow 255/255/153, FB-B:light brown 255/204/155, FB-RR: light orange 255/153/53
gmt psxy   FB_Area_A.psxy  -W0.5,255/255/120  -L -G255/255/120 
gmt psxy   FB_Area_RR.psxy -W0.5,255/255/120  -L -G255/255/120 
gmt psxy   FB_Area_B.psxy  -W0.5 -L -G255/204/155 
#gmt psxy   FB_Area_RR.psxy -W0.5,black -L -G255/153/53 

## add three loops
gmt psxy   TX_Counties.psxy  -W0.6,black -L 
##psxy $F $S Houston_IH99_outerloop.psxy -m -W10t20_10:0 
gmt psxy  Houston_SL8_middle_loop.psxy  -W2,gray -L 
gmt psxy  Houston_IH610_inner_loop.psxy  -W2,gray -L 

## permanent rivers
gmt pscoast -Df -I1/2.0p,blue,-  -Sdeepskyblue
### plot major TX Coast Cities
gmt text   -F+a0+f9+jMC   <<EOF 
-95.370 29.760 Houston
EOF
gmt text  -F+a0+f11+jMC     <<EOF  
-95  28.84    Gulf of Mexico
EOF



## plot the names of district
gmt text  -F+a0+f8+jMC   << EOF
-95.05  29.45  Galveston 
-95.05  29.4  County
-95.3  29.98  Harris County
#-95.345 30.2   Montgomery County
#-96.0  30.  Waller County
-95.75  29.5  Fort Bend County
#-95.4 29.1   Brazoria County
#-94.8 30.1   Liberty County
#-94.7 29.8 Chambers County
#-95.7   28.6 Matagorda County
#-96.1 29.3  Wharton County
#-96.3 29.9 Austin County
#-96.0 30.5 Grimes County
#-95.6 30.6 Walker County
#-95.15 30.55 San Jancito County
#-94.7   30.65 Polk County
EOF
gmt text  -F+a0+f8+jMC -Gwhite  << EOF
-95.02  29.6    Area 1
-95.35  29.65   HGSD Area 2
-95.7  30     HGSD Area 3
-95.8  29.37   FBSD Area B
-95.74  29.6  FBSD Area A
#-95.6 30.3 LSGCD
#-95.5 29.23 BCGCD
#-96 30.25  BGCD
#-95.1 30.45 LTGCD
EOF
gmt text  -F+a0+f10+jML -Gwhite  << EOF
-96.05  29.17   (c) HGSD&FBSD 2013 Plans
EOF

gmt subplot end
gmt end show













